<!--
  uitools.qrc —— 界面图标。
  这些 png 由 make_icons.py 画出来，改图标改那个脚本再重跑，不要手改 png。
-->
<RCC>
    <qresource prefix="/icons">
        <file alias="about.png">icons/about.png</file>
        <file alias="app.png">icons/app.png</file>
        <file alias="browse.png">icons/browse.png</file>
        <file alias="color.png">icons/color.png</file>
        <file alias="export.png">icons/export.png</file>
        <file alias="eye-off.png">icons/eye-off.png</file>
        <file alias="eye.png">icons/eye.png</file>
        <file alias="logo.png">icons/logo.png</file>
        <file alias="move-down.png">icons/move-down.png</file>
        <file alias="move-up.png">icons/move-up.png</file>
        <file alias="page-delete.png">icons/page-delete.png</file>
        <file alias="page-new.png">icons/page-new.png</file>
        <file alias="project-new.png">icons/project-new.png</file>
        <file alias="project-open.png">icons/project-open.png</file>
        <file alias="project-save-as.png">icons/project-save-as.png</file>
        <file alias="project-save.png">icons/project-save.png</file>
        <file alias="resize.png">icons/resize.png</file>
        <file alias="row-add.png">icons/row-add.png</file>
        <file alias="row-delete.png">icons/row-delete.png</file>
        <file alias="row-down.png">icons/row-down.png</file>
        <file alias="row-up.png">icons/row-up.png</file>
        <file alias="screenshot.png">icons/screenshot.png</file>
        <file alias="settings.png">icons/settings.png</file>
    </qresource>
</RCC>
